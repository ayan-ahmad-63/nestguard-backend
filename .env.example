# Copy to .env and fill in. The API refuses to start without the three secrets.
ENV=development                      # development | production
MONGO_URI=mongodb://localhost:27017  # Atlas: mongodb+srv://USER:PASS@cluster/...
MONGO_DB=nestguard

# Generate each with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
SERVICE_KEY=                         # shared with the Gate PC bridge (NESTGUARD_SERVICE_KEY)
TEMPLATE_ENCRYPTION_KEY=             # 64 hex chars (AES-256). Losing it makes stored fingerprints unreadable.

CLIENT_URL=http://localhost:5000     # the dashboard origin (CORS + Socket.IO)
EXTRA_ORIGINS=                       # comma separated, e.g. https://app.nestguard.live
ENABLED_MODULES=auth,students,biometric,access,gates,alerts,realtime
ENABLE_SIMULATE=false                # dev only: lets the login screen fake a thumb touch without hardware
